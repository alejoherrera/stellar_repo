# Schema de scripts/.env (gitignored).
# Copiar a scripts/.env y completar con los valores reales.
# Los valores reales NUNCA deben commitearse al repo publico.

# === Stellar testnet ===
# Llave Stellar (S...) generada por anchor_demo.py al primer run
STELLAR_TESTNET_SECRET=
STELLAR_TESTNET_PUBLIC=

# === Pinata (IPFS pinning) ===
# Cacheado por anchor_demo.py desde Google Secret Manager. Si lo borras se re-fetchea.
PINATA_JWT=

# === Google Cloud (Secret Manager) ===
# Proyecto GCP donde viven los secretos productivos
GCP_PROJECT=your-gcp-project-id

# Path absoluto al binario gcloud (Windows ejemplo)
GCLOUD_BIN=C:\Users\you\AppData\Local\Google\Cloud SDK\google-cloud-sdk\bin\gcloud.cmd

# === PythonAnywhere (deploy del viewer publico) ===
# Tu username de PythonAnywhere
PA_USER=your-pa-username

# Dominio del webapp en PA
PA_DOMAIN=www.your-domain.com

# Path absoluto al directorio raiz de tu Flask app en PA (sin slash final)
PA_PROJECT_PATH=/home/your-pa-username/your-project

# Nombre del secret en Google Secret Manager con el PA API token (default: pythonanywhere-token)
PA_TOKEN_SECRET=pythonanywhere-token
